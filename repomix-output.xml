// CONFIGURATION
const VAULT_ADDRESS = "0xe6e06F94d1aaa2496b9e33afeE29f01436E9fA4A";
const RPC_URL = "https://1rpc.io/sepolia";

// PARTIAL ABI (Only what we need)
const VAULT_ABI = [
    "function getPrimaryAPY() external view returns (uint256)",
    "function getSecondaryAPY() external view returns (uint256)",
    "function primaryAllocation() external view returns (uint256)",
    "function totalAssets() external view returns (uint256)",
    "function lastRebalanceTime() external view returns (uint256)"
];

document.addEventListener('DOMContentLoaded', () => {
    initAnimations();
    initInteractions();
    initRealData(); // REPLACED: initDataSim() -> initRealData()
});

// 1. GSAP Orchestration (The "Pop" Effect)
function initAnimations() {
    const tl = gsap.timeline();

    // Fade in background orbs
    tl.from('.orb', {
        duration: 2,
        opacity: 0,
        y: 100,
        stagger: 0.2,
        ease: 'power2.out'
    });

    // Header drops in
    tl.from('header', {
        duration: 0.8,
        y: -50,
        opacity: 0,
        ease: 'back.out(1.5)'
    }, '-=1.5');

    // Tiles pop in with DSi-like bounce
    tl.from('.tile', {
        duration: 0.8,
        scale: 0.8,
        opacity: 0,
        y: 50,
        stagger: 0.1,
        ease: 'back.out(1.7)' // The signature Nintendo bounce
    }, '-=0.5');

    // Liquid gauge fills up
    tl.from('.liquid-gauge', {
        duration: 1.5,
        scale: 0,
        rotation: -180,
        ease: 'elastic.out(1, 0.75)'
    }, '-=0.8');
}

// 2. Interactions (Tilt & Ripple)
function initInteractions() {
    const tiles = document.querySelectorAll('.tile');

    tiles.forEach(tile => {
        // 3D Tilt Effect
        tile.addEventListener('mousemove', (e) => {
            const rect = tile.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            // Calculate rotation (max 10deg)
            const xRot = ((y - rect.height / 2) / rect.height) * -10; // Invert Y for correct feel
            const yRot = ((x - rect.width / 2) / rect.width) * 10;

            gsap.to(tile, {
                duration: 0.5,
                rotationX: xRot,
                rotationY: yRot,
                transformPerspective: 1000,
                ease: 'power2.out'
            });
        });

        // Reset on leave
        tile.addEventListener('mouseleave', () => {
            gsap.to(tile, {
                duration: 0.5,
                rotationX: 0,
                rotationY: 0,
                ease: 'power2.out'
            });
        });

        // Ripple Effect on Click
        tile.addEventListener('click', function (e) {
            const ripple = document.createElement('div');
            ripple.classList.add('ripple');

            const rect = tile.getBoundingClientRect();
            const size = Math.max(rect.width, rect.height);

            ripple.style.width = ripple.style.height = `${size}px`;
            ripple.style.left = `${e.clientX - rect.left - size / 2}px`;
            ripple.style.top = `${e.clientY - rect.top - size / 2}px`;

            tile.appendChild(ripple);

            // Remove after animation
            setTimeout(() => {
                ripple.remove();
            }, 600);
        });
    });
}

// 3. REAL Data Connection (Ethers.js)
async function initRealData() {
    const yieldDisplay = document.querySelector('.yield-percent');
    const yieldLabel = document.querySelector('.yield-label');
    const logTerminal = document.querySelector('.log-terminal');

    addLog("Connecting to Sepolia RPC...", "cmd");

    try {
        const provider = new ethers.providers.JsonRpcProvider(RPC_URL);
        const vault = new ethers.Contract(VAULT_ADDRESS, VAULT_ABI, provider);

        addLog("Provider connected.", "success");
        addLog("Fetching authentic on-chain data...", "cmd");

        // Initial fetch
        updateData(vault, yieldDisplay, yieldLabel);

        // Poll every 15 seconds (block time is ~12s)
        setInterval(() => {
            updateData(vault, yieldDisplay, yieldLabel);
        }, 15000);

    } catch (error) {
        console.error(error);
        addLog("Connection Failed: " + error.message, "info"); // 'info' instead of 'error' for aesthetic color
    }

    function addLog(msg, type) {
        const div = document.createElement('div');
        div.classList.add('log-entry');

        const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

        div.innerHTML = `<span class="time">${time}</span> <span class="${type}">${msg}</span>`;
        logTerminal.appendChild(div);
        logTerminal.scrollTop = logTerminal.scrollHeight;
    }
}

async function updateData(vault, display, label) {
    try {
        // Fetch specific data points
        const primaryAPY = await vault.getPrimaryAPY();     // USDC APY (basis points)
        const secondaryAPY = await vault.getSecondaryAPY(); // DAI APY (basis points)
        const allocation = await vault.primaryAllocation(); // Basis points (e.g. 5000 = 50%)

        // Format values
        const usdcAPY = (primaryAPY.toNumber() / 1000).toFixed(2); // e.g. 5754 -> 5.75
        const daiAPY = (secondaryAPY.toNumber() / 1000).toFixed(2);  // e.g. 7109 -> 7.11
        const primaryAllocPercent = allocation.toNumber() / 100; // e.g. 20%
        const secondaryAllocPercent = 100 - primaryAllocPercent; // e.g. 80%

        // Determine winner
        const winner = parseFloat(daiAPY) > parseFloat(usdcAPY) ? "DAI" : "USDC";
        const winnerAPY = winner === "DAI" ? daiAPY : usdcAPY;

        // Update UI
        display.textContent = `${winnerAPY}%`;
        label.textContent = `APY (${winner})`; // Update label to show current winner

        // Log the spread
        const logDate = new Date().toLocaleTimeString();
        console.log(`[${logDate}] Data Updated: USDC ${usdcAPY}% | DAI ${daiAPY}% | Alloc: ${primaryAllocPercent}/${secondaryAllocPercent}`);

    } catch (e) {
        console.error("Data update error:", e);
    }
}
